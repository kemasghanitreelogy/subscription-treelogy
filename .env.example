# Salin ke .env untuk pengembangan lokal. Produksi: `fly secrets set …` — tidak ada
# satu pun secret di repo (IMPLEMENTATION.md §10.4).

# Toko tempat app terpasang
STORE_NAME=treelogymoringa.myshopify.com

# Shopify (dari Partner/Dev Dashboard setelah `npm run config:link`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_customers,write_orders,write_draft_orders,read_products

# Neon — dua connection string, jangan tertukar (STRUCTURE.md §4)
# PGSSLMODE wajib: PostgreSQLSessionStorage membuang query param URL (sslmode),
# pg fallback ke env var ini supaya koneksi session storage tetap TLS.
PGSSLMODE=require
# ber-suffix -pooler (PgBouncer) → process web
DATABASE_URL=
# direct → worker + migrasi
DATABASE_URL_DIRECT=

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# MID recurring kartu (Fase 0.2) — hanya perlu untuk charge KARTU; wallet jalan tanpa ini
XENDIT_MID_LABEL=

# Messaging
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=W8pW2A

# Ops
SENTRY_DSN=
APP_TIMEZONE=Asia/Jakarta
CHARGE_HOUR_WIB=10
PRECHARGE_HOUR_WIB=9
